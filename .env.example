APP_NAME=The333-BGP

# Host binding. Installer writes the real VM IP here.
THE333_BIND_IP=192.168.1.111

# Linux user/group that owns mounted data.
PUID=1000
PGID=1000

# BGP service.
LOCAL_AS=64500
ROUTER_ID=192.168.1.111
BGP_NEXTHOP=192.168.1.111
BGP_LISTEN_PORT=1179
PEER_ADDRESS=192.168.1.1
PEER_AS=65455
BGP_COMMUNITY=65432:500

# Portal/backend auth. The admin username is fixed.
# Installer writes WEB_PASSWORD_HASH. WEB_PASSWORD is kept only for legacy installs.
WEB_USER=admin
WEB_PASSWORD=
WEB_PASSWORD_HASH=pbkdf2_sha256:260000:CHANGE_ME_SALT_HEX:CHANGE_ME_HASH_HEX
AUTH_MAX_FAILURES=10
AUTH_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=600
WEB_HOST=0.0.0.0
WEB_PORT=8088

# Route safety.
AUTO_UPDATE=true
UPDATE_INTERVAL_SECONDS=21600
MAX_PREFIXES=30000
MIN_PREFIXES_TO_APPLY=1
MIN_EXPECTED_PREFIXES=0
MAX_DELTA_PERCENT=0
AGGREGATE_PREFIXES=true

# Service modules.
SERVICE_ROUTES_ENABLED=true
SERVICE_DNS_CACHE_GRACE_SECONDS=86400
SERVICE_GEOSITE_MAX_DOMAINS_PER_PROVIDER=100
SERVICE_GEOIP_MAX_PREFIXES_PER_PROVIDER=500

# System backups.
SYSTEM_BACKUP_RETENTION=20
SYSTEM_BACKUP_MAX_BYTES=134217728

# Product updates.
PRODUCT_VERSION=0.1
PRODUCT_CHANNEL=stable
PRODUCT_UPDATE_MANIFEST_URL=
PRODUCT_UPDATE_ENABLED=false
PRODUCT_UPDATE_COMMAND=/opt/the333-bgp/scripts/the333bgp.sh update --non-interactive
